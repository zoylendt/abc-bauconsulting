{% macro picture(id, className = "", loading = "lazy", decorative = false) %}
  {% set asset = id | image %}
  <img src="{{ asset.src }}" width="{{ asset.width }}" height="{{ asset.height }}"
       alt="{% if not decorative %}{{ asset.alt }}{% endif %}"
       class="{{ className }}" loading="{{ loading }}" decoding="async">
{% endmacro %}

{% macro searchForm(id) %}
  <form class="search-form" role="search" action="/suche/" method="get">
    <label class="sr-only" for="{{ id }}">Website durchsuchen</label>
    <input id="{{ id }}" type="search" name="q" placeholder="Suchen …" required>
    <button type="submit" aria-label="Suche starten">
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg>
    </button>
  </form>
{% endmacro %}
